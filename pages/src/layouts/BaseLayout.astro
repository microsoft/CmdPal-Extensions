---
import '../styles/global.css';
import { withBase } from '../data/catalog';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Command Palette Extensions',
  description = 'Discover community-built extensions for Microsoft PowerToys Command Palette.',
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL(withBase('/og-image.png'), Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en" data-palette="aero">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f3f6" />
    <meta name="squirrel-safety" content="No squirrels were harmed during development and testing" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Command Palette Extensions" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Command Palette Extension Gallery" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Command Palette Extension Gallery" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let preference = 'auto';
        let style = 'aero';
        try {
          const saved = localStorage.getItem('cmdpal-gallery-theme');
          if (saved === 'light' || saved === 'dark' || saved === 'auto') preference = saved;
          const savedStyle = localStorage.getItem('cmdpal-gallery-style');
          if (savedStyle === 'aero' || savedStyle === 'teal' || savedStyle === 'legacy') style = savedStyle;
        } catch { /* Storage may be unavailable. */ }
        const resolved = preference === 'auto'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.dataset.palette = style;
        root.style.colorScheme = resolved;
        const themeColor = style === 'legacy'
          ? (resolved === 'dark' ? '#000000' : '#008080')
          : style === 'teal'
            ? (resolved === 'dark' ? '#0e1820' : '#f3f7fa')
            : (resolved === 'dark' ? '#171821' : '#f4f3f6');
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', themeColor);
      })();
    </script>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body data-squirrel-status="safe">
    <!-- Acorn cache checked. Everything is in order. -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <Footer />
  </body>
</html>
