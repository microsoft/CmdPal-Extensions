---
import BrandMark from './BrandMark.astro';
import StylePicker from './StylePicker.astro';
import ThemePicker from './ThemePicker.astro';
import { withBase } from '../data/catalog';

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---

<header class:list={['site-header', { dark }]}>
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label="Command Palette Extensions home">
      <BrandMark />
      <span>Command Palette</span>
      <span class="brand-section">Extensions</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={withBase('/#gallery')}>Browse</a>
      <a href="https://learn.microsoft.com/en-us/windows/powertoys/command-palette/overview">About</a>
      <a href="https://learn.microsoft.com/windows/powertoys/command-palette/extension-development">Build</a>
      <a class="install-link" href="https://learn.microsoft.com/en-us/windows/powertoys/install?tabs=gh%2Cextract-094">
        <span class="install-label-long">Get Command Palette</span>
        <span class="install-label-short">Install</span>
      </a>
      <StylePicker />
      <ThemePicker />
      <a class="github-link" href="https://github.com/microsoft/CmdPal-Extensions" aria-label="View the catalog on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.24.7-3.92-1.37-3.92-1.37-.53-1.35-1.3-1.71-1.3-1.71-1.06-.73.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.28.74-1.57-2.59-.3-5.31-1.3-5.31-5.68 0-1.26.45-2.28 1.2-3.09-.12-.29-.52-1.48.11-3.05 0 0 .98-.31 3.16 1.18a10.98 10.98 0 0 1 5.75 0c2.19-1.49 3.16-1.18 3.16-1.18.63 1.57.23 2.76.11 3.05.75.81 1.2 1.83 1.2 3.09 0 4.39-2.73 5.38-5.33 5.67.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    height: 68px;
    position: relative;
    z-index: 20;
    color: var(--ink);
    border-bottom: 1px solid var(--stroke-subtle);
    background: color-mix(in srgb, var(--canvas) 84%, transparent);
    backdrop-filter: blur(20px) saturate(1.25);
  }

  .site-header.dark {
    color: #f7f9ff;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    background: var(--header-dark-background);
  }

  .header-inner {
    width: min(calc(100% - 48px), 1320px);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    color: inherit;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-section {
    color: currentColor;
    opacity: 0.58;
    font-weight: 500;
    padding-left: 10px;
    border-left: 1px solid currentColor;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  nav a {
    color: inherit;
    font-size: 14px;
    font-weight: 520;
    text-decoration: none;
    opacity: 0.78;
    transition: opacity 150ms ease;
  }

  nav a:hover {
    opacity: 1;
  }

  nav .install-link {
    min-height: var(--compact-action-height);
    padding: 0 var(--compact-action-padding-inline);
    display: inline-flex;
    align-items: center;
    color: var(--on-accent);
    border-radius: var(--action-radius);
    opacity: 1;
    background: var(--accent);
    font-weight: 650;
  }

  .site-header.dark nav .install-link {
    color: #062334;
    background: #60cdff;
  }

  nav .install-link:hover {
    background: var(--accent-hover);
  }

  .install-label-short {
    display: none;
  }

  .site-header.dark nav .install-link:hover {
    background: #8cddff;
  }

  .github-link {
    width: var(--compact-action-height);
    height: var(--compact-action-height);
    display: grid;
    place-items: center;
    border: 0;
    border-radius: var(--action-radius);
    opacity: .62;
    background: transparent;
    transition: opacity 150ms ease, background 150ms ease;
  }

  .github-link:hover {
    opacity: 1;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .github-link:focus-visible {
    outline: 2px solid color-mix(in srgb, currentColor 72%, transparent);
    outline-offset: -2px;
    opacity: 1;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .github-link svg {
    width: 18px;
    fill: currentColor;
  }

  :global(html[data-palette='legacy']) .site-header,
  :global(html[data-palette='legacy']) .site-header.dark {
    height: 58px;
    color: var(--ink);
    border: 0;
    border-bottom: 2px outset var(--classic-face);
    background: var(--classic-face);
    backdrop-filter: none;
  }

  :global(html[data-palette='legacy']) .header-inner {
    width: calc(100% - 16px);
    gap: 16px;
  }

  :global(html[data-palette='legacy']) .brand {
    gap: 7px;
    font-family: Tahoma, "MS Sans Serif", Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
  }

  :global(html[data-palette='legacy']) .brand :global(img) {
    image-rendering: pixelated;
  }

  :global(html[data-palette='legacy']) .brand-section {
    padding-left: 8px;
    opacity: 1;
    border-left-color: var(--classic-shadow);
    font-weight: 400;
  }

  :global(html[data-palette='legacy']) nav {
    gap: 10px;
  }

  :global(html[data-palette='legacy']) nav a {
    color: var(--ink);
    font-family: Tahoma, "MS Sans Serif", Arial, sans-serif;
    font-size: 12px;
    font-weight: 400;
    opacity: 1;
  }

  :global(html[data-palette='legacy']) nav .install-link,
  :global(html[data-palette='legacy']) .site-header.dark nav .install-link {
    min-height: 28px;
    padding: 0 10px;
    color: var(--ink);
    border: 2px outset var(--classic-face);
    border-radius: 0;
    background: var(--classic-face);
    font-weight: 700;
  }

  :global(html[data-palette='legacy']) nav .install-link:active,
  :global(html[data-palette='legacy']) .site-header.dark nav .install-link:active {
    border-style: inset;
    background: var(--classic-face);
    transform: translate(1px, 1px);
  }

  :global(html[data-palette='legacy']) .github-link {
    width: 28px;
    height: 28px;
    color: var(--ink);
    border: 2px outset var(--classic-face);
    border-radius: 0;
    opacity: 1;
    background: var(--classic-face);
  }

  :global(html[data-palette='legacy']) .github-link:hover,
  :global(html[data-palette='legacy']) .github-link:focus-visible {
    color: var(--ink);
    border-style: outset;
    outline: 1px dotted var(--ink);
    outline-offset: -5px;
    background: var(--classic-face);
  }

  :global(html[data-palette='legacy']) .github-link:active {
    border-style: inset;
  }

  @media (max-width: 720px) {
    .header-inner {
      width: min(calc(100% - 32px), 1320px);
    }

    .brand-section,
    nav a:not(.github-link):not(.install-link) {
      display: none;
    }

    nav {
      gap: 10px;
    }

    :global(html[data-palette='legacy']) .header-inner {
      width: calc(100% - 12px);
    }

    nav .install-link {
      min-height: var(--compact-action-height);
      padding: 0 12px;
      font-size: 12px;
    }

    .install-label-long {
      display: none;
    }

    .install-label-short {
      display: inline;
    }
  }
</style>
